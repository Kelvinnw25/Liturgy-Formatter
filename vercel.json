{
    "version": 2,
    "builds": [
        { "src": "react/package.json", "use": "@vercel/next" },
        { "src": "fastAPI/app/main.py", "use": "@vercel/python" }
    ],
    "rewrites": [
        { "source": "/api/:path*", "destination": "fastAPI/app/main.py" },
        { "source": "/(.*)", "destination": "react/$1" } 
    ]
}